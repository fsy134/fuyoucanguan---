.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部条 */
.head-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 24rpx 30rpx;
}

.head-title {
  font-size: 32rpx;
  font-weight: bold;
}

.head-clear {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

/* 购物车清单 */
.cart-list {
  flex: 1;
  padding-bottom: 40rpx;
}

.cart-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.row-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #faf6f0;
}

.row-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.row-info {
  flex: 1;
  margin-left: 20rpx;
}

.row-name {
  font-size: 30rpx;
  font-weight: bold;
}

.row-flavor {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.row-price {
  font-size: 28rpx;
  color: #d9822b;
  font-weight: bold;
  margin-top: 8rpx;
}

/* 行内数量步进 */
.row-stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #555;
}

.step-num {
  min-width: 72rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
}

/* 空购物车 */
.cart-empty {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-btn {
  margin: 40rpx 200rpx 0;
  line-height: 76rpx;
}

/* 备注 */
.remark-box {
  background: #fff;
  margin-top: 20rpx;
  padding: 24rpx 30rpx;
}

.remark-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

/* 底部结算栏 */
.footer {
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
}

.footer-sum {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sum-info {
  font-size: 26rpx;
  color: #b06a1c;
}

.sum-total {
  font-size: 28rpx;
  color: #333;
}

.total-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #d9822b;
}

.footer-btns {
  display: flex;
  gap: 24rpx;
}

.btn-back {
  flex: 1;
  background: #fff;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 68rpx;
  padding: 0;
}

.btn-submit {
  flex: 1;
  background: #d9822b;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 68rpx;
  padding: 0;
}
