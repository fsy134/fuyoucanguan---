<view class="page">
  <!-- 状态筛选 -->
  <view class="tabs">
    <view class="tab {{activeStatus === item.value ? 'active' : ''}}"
          wx:for="{{tabs}}" wx:key="value"
          data-status="{{item.value}}" bindtap="switchTab">{{item.label}}</view>
  </view>

  <!-- 订单列表 -->
  <view class="order-card" wx:for="{{orders}}" wx:key="id"
        data-id="{{item.id}}" bindtap="goDetail">
    <view class="order-head">
      <view class="order-time">{{item.orderTime}}</view>
      <view class="order-status {{item.statusInfo.cls}}">{{item.statusInfo.text}}</view>
    </view>
    <view class="order-summary">{{item.summary || '（无菜品明细）'}}</view>
    <view class="order-foot">
      <view class="order-amount">合计 <text class="amount-num">¥{{item.amountText}}</text></view>
      <view class="order-reorder" wx:if="{{item.status === 5}}"
            data-id="{{item.id}}" catchtap="onReorder">再来一单</view>
    </view>
  </view>

  <!-- 列表底部状态 -->
  <view class="list-tip" wx:if="{{loading}}">加载中…</view>
  <view class="list-tip" wx:elif="{{finished && orders.length}}">没有更多订单了</view>

  <!-- 空态 -->
  <view class="empty" wx:if="{{!loading && finished && !orders.length}}">
    <view class="empty-icon">📋</view>
    <view>还没有订单，去点几个菜吧</view>
    <button class="btn-primary empty-btn" bindtap="goOrder">去点餐</button>
  </view>
</view>
