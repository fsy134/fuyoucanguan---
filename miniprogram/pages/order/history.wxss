.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 状态筛选栏 */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 10rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #b06a1c;
  font-weight: bold;
}

/* 选中状态下的琥珀色短横线 */
.tab.active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #d9822b;
}

/* 订单卡片 */
.order-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 26rpx 30rpx;
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
}

.s-pending {
  background: #fdf3e7;
  color: #b06a1c;
}

.s-done {
  background: #e8f5e9;
  color: #2e7d32;
}

.s-canceled {
  background: #f5f5f5;
  color: #999;
}

.order-summary {
  font-size: 28rpx;
  color: #333;
  margin-top: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 18rpx;
}

.order-amount {
  font-size: 26rpx;
  color: #666;
}

.amount-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #d9822b;
}

.order-reorder {
  font-size: 26rpx;
  color: #d9822b;
  border: 2rpx solid #d9822b;
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
}

/* 列表底部提示 */
.list-tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 30rpx 0;
}

/* 空态 */
.empty {
  padding: 160rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-btn {
  margin: 40rpx 200rpx 0;
  line-height: 76rpx;
}
