.page {
  height: 100vh;
  overflow: hidden;
  position: relative;
}

/* ===== 顶部：背景图 + 悬浮店铺卡片 ===== */
.shop-header {
  position: relative;
}

/* 背景图固定高度 375rpx：图是 2:1（1500x750），全宽显示刚好不裁剪 */
.shop-bg {
  width: 100%;
  height: 375rpx;
  display: block;
}

/* 渐变遮罩：上部几乎透明（看清图里的店名），下部加深衬托悬浮卡片 */
.shop-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.02) 30%, rgba(0, 0, 0, 0.2) 65%, rgba(0, 0, 0, 0.45) 100%);
}

/* 悬浮白卡片：压在背景图下边缘，像一张名片浮在图上 */
.shop-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: -40rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.18);
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  z-index: 2;
}

.shop-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  background: #fff;
  flex-shrink: 0;
}

.shop-info {
  margin-left: 24rpx;
  flex: 1;
}

.shop-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #3a2a1a;
}

.shop-notice {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.shop-hours {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b06a1c;
  background: #fdf3e7;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* ===== 桌号人数条（高度固定 96rpx + 上边距 40rpx，共 136rpx） ===== */
.table-banner {
  margin-top: 40rpx;
  height: 96rpx;
  box-sizing: border-box;
  background: #fdf6ec;
  color: #b06a1c;
  font-size: 26rpx;
  padding: 0 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-link {
  font-size: 24rpx;
  color: #b06a1c;
  padding: 8rpx 0 8rpx 20rpx;
}

/* ===== 左侧分类导航：悬浮固定在左边，不随菜品滚动 ===== */
.category-side {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 180rpx;
  background: #f7f7f7;
  z-index: 10;
}

.cat-item {
  position: relative;
  padding: 26rpx 10rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.cat-item.active {
  background: #fff;
  color: #3a2a1a;
  font-weight: bold;
}

/* 招牌菜分类：名字用琥珀色突出 */
.cat-item.featured {
  color: #b06a1c;
}

.cat-item.featured.active {
  color: #b06a1c;
}

/* "荐"字小标签 */
.cat-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #fff;
  background: #d9822b;
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}

/* 选中分类左侧的琥珀色小竖条 */
.cat-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 30%;
  height: 40%;
  width: 6rpx;
  background: #d9822b;
  border-radius: 3rpx;
}

.cat-empty {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}

/* 整页滚动区：背景图、商家卡片、桌号条、菜品列表都在这里一起滚 */
.dish-main {
  height: 100%;
  background: #fff;
}

/* 菜品列表区：左边让出分类导航的位置 */
.menu-content {
  padding-left: 180rpx;
}

/* 列表底部留白：别让最后一道菜被购物车球挡住 */
.bottom-space {
  height: 160rpx;
}

/* 分类小标题（高度固定 72rpx，滚动联动靠它计算） */
.sec-header {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  background: #faf6f0;
  font-size: 26rpx;
  color: #3a2a1a;
  font-weight: bold;
  box-sizing: border-box;
}

/* 菜品卡片（高度固定 230rpx，滚动联动靠它计算） */
.dish-item {
  display: flex;
  align-items: center;
  height: 230rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-img {
  width: 170rpx;
  height: 170rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #faf6f0;
}

.dish-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.dish-info {
  flex: 1;
  height: 100%;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dish-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-price {
  color: #d9822b;
  font-weight: bold;
  font-size: 32rpx;
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #d9822b;
  color: #fff;
  font-size: 40rpx;
  line-height: 52rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(217, 130, 43, 0.4);
}

.sec-empty {
  padding: 30rpx 0;
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
}

.dish-empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

/* ===== 人数弹窗宫格 ===== */
.people-grid {
  display: flex;
  flex-wrap: wrap;
}

.people-item {
  width: 25%;
  box-sizing: border-box;
  padding: 10rpx;
}

.people-item-inner {
  background: #fdf3e7;
  color: #b06a1c;
  border-radius: 12rpx;
  padding: 18rpx 0;
  font-size: 28rpx;
  text-align: center;
}
