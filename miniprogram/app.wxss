/* 全局样式 */
page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
  height: 100%;
}

/* 按钮去掉默认边框 */
button::after {
  border: none;
}

/* 通用：琥珀橙主按钮 */
.btn-primary {
  background: #d9822b;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}

/* 通用：弹窗遮罩（半透明黑色背景） */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 通用：弹窗白卡片 */
.modal-box {
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

/* 悬浮入场动画：内容从下方轻轻浮起 */
@keyframes floatUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.anim-float {
  animation: floatUp 0.5s ease-out both;
}
