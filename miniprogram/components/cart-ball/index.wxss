.cart-ball {
  position: fixed;
  right: 30rpx;
  bottom: 50rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  background: #3a2a1a;
  border-radius: 48rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

/* 空车时稍微半透明 */
.ball-empty {
  opacity: 0.85;
}

.ball-icon {
  font-size: 44rpx;
  line-height: 1;
}

.ball-amount {
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  margin-left: 12rpx;
}

/* 红色小徽标：显示点了多少件 */
.ball-badge {
  position: absolute;
  top: -12rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: #e64340;
  color: #fff;
  border-radius: 18rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}
