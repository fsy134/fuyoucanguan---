/* 弹窗遮罩：面板从底部滑上来 */
.popup-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.popup-panel {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.popup-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.popup-title {
  font-size: 34rpx;
  font-weight: bold;
}

.popup-price {
  color: #d9822b;
  font-weight: bold;
  font-size: 32rpx;
  margin-top: 8rpx;
}

.popup-close {
  font-size: 44rpx;
  color: #999;
  line-height: 1;
  padding: 0 8rpx;
}

.popup-body {
  max-height: 50vh;
}

/* 套餐包含清单 */
.detail-box {
  background: #faf6f0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 24rpx;
}

.detail-title {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.detail-item {
  font-size: 26rpx;
  color: #555;
  padding: 6rpx 0;
}

/* 口味维度 */
.flavor-dim {
  margin-top: 24rpx;
}

.dim-name {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 14rpx;
}

/* 多选维度的提示文字 */
.dim-hint {
  font-size: 22rpx;
  color: #aaa;
  font-weight: normal;
  margin-left: 10rpx;
}

.dim-options {
  display: flex;
  flex-wrap: wrap;
}

.dim-option {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
  color: #555;
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
  border: 2rpx solid transparent;
}

.dim-option.active {
  background: #fdf3e7;
  color: #b06a1c;
  border-color: #d9822b;
}

/* 底部操作区 */
.popup-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #555;
}

.step-btn.disabled {
  opacity: 0.4;
}

.step-num {
  min-width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

.confirm-btn {
  background: #d9822b;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 0 56rpx;
  line-height: 76rpx;
}
